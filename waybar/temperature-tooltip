#!/usr/bin/env python3

import glob
import json
import os


def sensors_for(device):
    for hwmon in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(hwmon, "name"), encoding="ascii") as name_file:
                if name_file.read().strip() != device:
                    continue
            readings = {}
            for input_path in glob.glob(os.path.join(hwmon, "temp*_input")):
                stem = input_path[:-6]
                label_path = stem + "_label"
                try:
                    with open(label_path, encoding="ascii") as label_file:
                        label = label_file.read().strip()
                except FileNotFoundError:
                    label = os.path.basename(stem)
                with open(input_path, encoding="ascii") as input_file:
                    readings[label] = int(input_file.read().strip()) / 1000
            return readings
        except (FileNotFoundError, PermissionError, ValueError):
            continue
    return {}


cpu = sensors_for("coretemp")
nvme = sensors_for("nvme")
package = cpu.get("Package id 0")
cores = sorted(
    ((label, value) for label, value in cpu.items() if label.startswith("Core ")),
    key=lambda item: int(item[0].split()[-1]),
)
nvme_temp = nvme.get("Composite")

if package is None:
    package = max((value for _, value in cores), default=0)

labels = [("CPU package", package)]
labels.extend(cores)
labels.append(("NVMe SSD", nvme_temp))
label_width = max(len(label) for label, _ in labels)
tooltip_rows = [
    f"{label:<{label_width}} : {value:.0f}°C" if value is not None
    else f"{label:<{label_width}} : unavailable"
    for label, value in labels
]

print(json.dumps({
    "text": f" {package:.0f}°C",
    "tooltip": "\n".join(tooltip_rows),
}, ensure_ascii=False))
